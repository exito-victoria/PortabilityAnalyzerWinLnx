{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portability-analyzer/schemas/portability-rules.schema.json",
  "title": "Catalogo de reglas de portabilidad Windows -> Linux",
  "description": "Valida la estructura del catalogo de reglas consumido por la herramienta de analisis. Rechaza reglas mal formadas, severidades/confianzas fuera de dominio e ids con formato incorrecto.",
  "type": "object",
  "required": ["schemaVersion", "reglas"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "metadata": { "type": "object" },
    "modeloEsfuerzo": { "type": "object" },
    "severidades": {
      "type": "array",
      "items": { "type": "string" }
    },
    "categorias": { "type": "object" },
    "reglas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/regla" }
    }
  },
  "$defs": {
    "severidad": {
      "enum": ["Info", "Bajo", "Medio", "Alto", "Bloqueante"]
    },
    "confianza": {
      "enum": ["Alta", "Media", "Baja"]
    },
    "estrategiaSeparacion": {
      "enum": ["Comun", "AbstraerPorPlataforma", "ReemplazarDependencia", "RedisenoUI"]
    },
    "categoria": {
      "enum": [
        "PInvoke",
        "COM",
        "AssemblyReference",
        "PlatformAttribute",
        "Registry",
        "Cryptography",
        "Identity",
        "Threading",
        "ProcessInvocation",
        "FileSystem",
        "Database",
        "Misc"
      ]
    },
    "patronTipo": {
      "enum": [
        "pInvokeDll",
        "assemblyReference",
        "namespace",
        "type",
        "method",
        "attribute",
        "apiCall",
        "stringLiteral"
      ]
    },
    "matchMode": {
      "enum": ["equals", "startsWith", "contains", "regex"]
    },
    "esfuerzo": {
      "type": "object",
      "required": ["optimista", "masProbable", "pesimista"],
      "additionalProperties": false,
      "properties": {
        "optimista": { "type": "number", "minimum": 0 },
        "masProbable": { "type": "number", "minimum": 0 },
        "pesimista": { "type": "number", "minimum": 0 }
      }
    },
    "patron": {
      "type": "object",
      "required": ["tipo", "valor", "matchMode"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "$ref": "#/$defs/patronTipo" },
        "valor": { "type": "string", "minLength": 1 },
        "matchMode": { "$ref": "#/$defs/matchMode" },
        "argumentoContiene": { "type": "string" },
        "nota": { "type": "string" }
      }
    },
    "regla": {
      "type": "object",
      "required": [
        "id",
        "categoria",
        "descripcion",
        "patron",
        "severidad",
        "esBloqueante",
        "alternativaLinux",
        "esfuerzo",
        "confianza"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "categoria": { "$ref": "#/$defs/categoria" },
        "descripcion": { "type": "string", "minLength": 1 },
        "patron": { "$ref": "#/$defs/patron" },
        "severidad": { "$ref": "#/$defs/severidad" },
        "esBloqueante": { "type": "boolean" },
        "alternativaLinux": { "type": "string" },
        "esfuerzo": { "$ref": "#/$defs/esfuerzo" },
        "confianza": { "$ref": "#/$defs/confianza" },
        "pasosRemediacion": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "estrategiaSeparacion": { "$ref": "#/$defs/estrategiaSeparacion" },
        "notaComun": { "type": "string" }
      }
    }
  }
}
